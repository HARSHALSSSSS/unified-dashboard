# =============================================================================
# OMS Platform - environment template.   cp .env.example .env
# NEVER commit .env or real secrets. Staging/production use real environment variables
# injected from a secret manager (AWS Secrets Manager / SSM / Vault) - no .env files shipped.
# Load order (first wins; real env vars beat files):
#   .env.<NODE_ENV>.local -> .env.<NODE_ENV> -> .env
# All values are validated at startup by packages/config (fail fast, lists every problem).
# =============================================================================

# ---- application ------------------------------------------------------------
NODE_ENV=development            # development | test | staging | production
APP_NAME=oms
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=debug                 # fatal|error|warn|info|debug|trace|silent
LOG_PRETTY=true                 # human readable logs (development only)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001   # comma separated allow-list
TRUST_PROXY=false               # number of trusted proxy hops (1 = one load balancer) or proxy CIDRs; never "true" in production
# SWAGGER_ENABLED=true          # default: on everywhere except production
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10          # login/refresh per window per IP
METRICS_ENABLED=true
# METRICS_TOKEN=                # if set, /metrics requires "Authorization: Bearer <token>"

# ---- database (PostgreSQL) --------------------------------------------------
# Runtime role: NOT owner, NOT superuser, so row-level security always applies to the app.
DATABASE_URL=postgres://oms_app:oms_app@localhost:5432/oms
# Migration/seed role: owns the schema. Used only by `pnpm db:migrate` / `db:seed`.
DATABASE_MIGRATION_URL=postgres://oms_owner:oms_owner@localhost:5432/oms
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_SSL=false

# ---- redis (queues, rate limiting, cache) -----------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=oms

# ---- object storage (S3 compatible; MinIO locally) --------------------------
STORAGE_DRIVER=s3               # s3 (AWS S3 / MinIO / R2) | memory (no external service; data lost on restart)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=oms-media
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true   # true for MinIO, false for AWS S3

# ---- auth / security --------------------------------------------------------
JWT_ISSUER=oms
JWT_AUDIENCE=oms-api
# >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-dev-only-change-me-dev-only-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# keyId:base64(32 bytes), comma separated; FIRST is active, others decrypt-only (key rotation).
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=dev1:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
WEBHOOK_SIGNING_TOLERANCE_SECONDS=300
EMAIL_VERIFICATION_REQUIRED=false   # true in staging/production: verified e-mail needed to invite users / connect marketplaces
APP_WEB_URL=http://localhost:5173   # base URL of the web app used in e-mailed links (verify, reset, invitation)
# MOCK_MARKETPLACE_ENABLED=true     # sandbox marketplace; default: on outside production, off in production

# ---- observability ----------------------------------------------------------
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SENTRY_DSN=

# ---- workers ----------------------------------------------------------------
WORKER_CONCURRENCY=10
WORKER_HEALTH_PORT=3100
# WORKER_QUEUES=marketplacePush         # run a replica dedicated to specific queues

# ---- platform-level marketplace app credentials (NOT per-vendor tokens) ------
# Per-vendor tokens/secrets are stored AES-256-GCM encrypted in the database, never here.
# AMAZON_IN_LWA_CLIENT_ID=
# AMAZON_IN_LWA_CLIENT_SECRET=
# FLIPKART_APP_ID=
# FLIPKART_APP_SECRET=
# MYNTRA_PARTNER_ID=
# MYNTRA_PARTNER_SECRET=
# SNAPDEAL_PARTNER_ID=
# SNAPDEAL_PARTNER_SECRET=

# ---- third party ------------------------------------------------------------
# SMTP_URL=smtp://user:pass@localhost:1025

# ---- Stage 3: sync engine / connectors ---------------------------------------
# CONNECTOR_RETRY_ATTEMPTS=3          # in-call retries (5xx / 429)
# CONNECTOR_RETRY_BASE_MS=250
# CONNECTOR_RETRY_MAX_MS=5000
# CONNECTOR_RETRY_AFTER_CAP_MS=10000  # longest marketplace Retry-After honoured inside one call
# SYNC_MAX_ATTEMPTS=5                 # job attempts before dead-lettering
# SYNC_BACKOFF_BASE_MS=30000          # exponential backoff between job attempts
# SYNC_BACKOFF_MAX_MS=900000
# WEBHOOK_MAX_ATTEMPTS=6
# WEBHOOK_RETENTION_DAYS=30
# PUBLIC_API_URL=https://api.example.com   # shown as the webhook callback URL
