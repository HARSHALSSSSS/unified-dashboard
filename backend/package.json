{
  "name": "oms-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-vendor commerce operating platform (OMS) - backend monorepo",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @oms/api dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r --no-bail typecheck && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:api": "vitest run --project api",
    "test:database": "vitest run --project database",
    "test:contract": "vitest run --project contract",
    "test:connector": "vitest run --project connector",
    "test:e2e": "vitest run --project e2e",
    "check:modules": "tsx scripts/check-modules.ts",
    "scaffold:modules": "node scripts/scaffold-modules.mjs",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "db:generate": "pnpm --filter @oms/database db:generate",
    "db:migrate": "pnpm --filter @oms/database db:migrate",
    "db:seed": "pnpm --filter @oms/database db:seed",
    "db:create-admin": "pnpm --filter @oms/database db:create-admin",
    "infra:up": "docker compose up -d postgres redis minio",
    "stack:up": "docker compose --profile app up --build",
    "stack:down": "docker compose --profile app --profile observability down"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@oms/api": "workspace:*",
    "@oms/auth": "workspace:*",
    "@oms/config": "workspace:*",
    "@oms/connectors": "workspace:*",
    "@oms/contracts": "workspace:*",
    "@oms/database": "workspace:*",
    "@oms/logging": "workspace:*",
    "@oms/marketplace-core": "workspace:*",
    "@oms/messaging": "workspace:*",
    "@oms/module-kit": "workspace:*",
    "@oms/modules-registry": "workspace:*",
    "@oms/observability": "workspace:*",
    "@oms/runtime": "workspace:*",
    "@oms/shared": "workspace:*",
    "@oms/testing": "workspace:*",
    "@types/node": "^26.6.4",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.12.0",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "zod": "^4.6.5",
    "@oms/connector-amazon-in": "workspace:*",
    "@oms/connector-flipkart": "workspace:*",
    "@oms/connector-myntra": "workspace:*",
    "@oms/connector-snapdeal": "workspace:*",
    "@oms/connector-mock": "workspace:*",
    "@oms/mod-sync": "workspace:*",
    "@oms/mod-warehouses": "workspace:*",
    "@oms/mod-inventory": "workspace:*",
    "@oms/mod-listings": "workspace:*",
    "@oms/mod-orders": "workspace:*",
    "@oms/mod-webhooks": "workspace:*",
    "@oms/mod-marketplace-connectors": "workspace:*",
    "@oms/mod-catalog": "workspace:*"
  }
}
